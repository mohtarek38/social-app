## DATABASE CONFIGURATION  ##
DB_URL_LOCAL = mongodb://127.0.0.1:27017/social_app
MONGO_DB_URL = mongodb+srv://<user>:<password>@<cluster>/social_app

## SERVER CONFIGURATION  ##
PORT = 5000
SALT_ROUNDS = 10

## EMAIL CONFIGURATION  ##
# Gmail address + app password used by nodemailer to send OTP emails
USER_EMAIL = your-email@gmail.com
USER_PASSWORD = your-app-password

## ENCRYPTION CONFIGURATION  ##
# Must be exactly 32 characters (AES-256)
ENCRYPTION_KEY = change-me-to-32-characters-long
IV_LENGTH = 16

## JWT CONFIGURATION  ##
JWT_ACCESS_SECRET = change-me
JWT_ACCESS_EXPIRATION = 30min
JWT_REFRESH_SECRET = change-me-too
JWT_REFRESH_EXPIRATION = 1d
JWT_PREFIX = Bearer

## CORS CONFIGURATION  ##
CORS_WHITELIST = http://localhost:5500

## GOOGLE OAUTH CONFIGURATION  ##
GOOGLE_CLIENT_ID = your-google-client-id.apps.googleusercontent.com

## CLOUDINARY CONFIGURATION  ##
CLOUDINARY_URL = cloudinary://<api_key>:<api_secret>@<cloud_name>

## AWS S3 CONFIGURATION  ##
AWS_ACCESS_KEY_ID = your-access-key-id
AWS_SECRET_ACCESS_KEY = your-secret-access-key
AWS_REGION = eu-north-1
BUCKET_NAME = your-bucket-name
AWS_S3_KEY_FOLDER = social_app
